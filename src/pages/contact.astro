---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact | NGUYEN HOANG NAM - Architect">
	<section class="architect-card">
		<!-- Cột trái: Thông tin & Bản vẽ phác thảo nền -->
		<div class="card-left">
			<img src="/images/sketch.png" alt="Architectural Sketch" class="bg-sketch" onerror="this.style.display='none'" />
			
			<div class="card-content">
				<h1 class="architect-name">NGUYEN HOANG NAM</h1>
				<p class="architect-role">Architect</p>

				<div class="direct-details">
					<p>
						<span class="prefix">M:</span>
						<a href="tel:0866815479">#</a>
					</p>
					<p>
						<span class="prefix">E:</span>
						<a href="mailto:namk.nguyenhoang@gmail.com">namk.nguyenhoang@gmail.com</a>
					</p>
					<p>
						<span class="prefix">W:</span>
						<a href="https://namk.vn">namk.vn</a>
					</p>
				</div>
			</div>
		</div>

		<!-- Cột phải: Ảnh chân dung nền xám nhạt -->
		<div class="card-right">
			<div class="portrait-frame">
				<img src="/images/avatar.png" alt="Nguyen Hoang Nam - Architect" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
				<div class="portrait-placeholder">Portrait Image</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	.architect-card {
		display: grid;
		grid-template-columns: 1fr 1fr;
		border: 1px solid var(--border);
		background-color: #ffffff;
		margin-bottom: 4rem;
		min-height: 520px;
	}

	/* Cột trái: Nền trắng + Sketch chìm */
	.card-left {
		position: relative;
		background-color: #ffffff;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		padding: 3.5rem 2rem;
		overflow: hidden;
	}
	.bg-sketch {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 85%;
		max-width: 380px;
		height: auto;
		opacity: 0.22;
		pointer-events: none;
		z-index: 1;
	}
	.card-content {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 100%;
	}
	.architect-name {
		font-size: 1.65rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
		margin-bottom: 0.6rem;
	}
	.architect-role {
		font-size: 1.05rem;
		font-weight: 300;
		letter-spacing: 0.08em;
		color: var(--text-main);
		margin-bottom: 10rem;
	}
	.direct-details {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		font-size: 0.98rem;
		color: var(--text-main);
		letter-spacing: 0.03em;
	}
	.direct-details .prefix {
		color: var(--text-muted);
		margin-right: 0.3rem;
	}
	.direct-details a {
		color: var(--text-main);
		text-decoration: none;
		transition: color 0.25s ease;
	}
	.direct-details a:hover {
		color: var(--accent);
	}

	/* Cột phải: Nền xám nhạt #ececec + Khung ảnh chân dung */
	.card-right {
		background-color: #ececec;
		display: flex;
		justify-content: center;
		align-items: center;
		padding: 3.5rem;
	}
	.portrait-frame {
		width: 100%;
		max-width: 310px;
		aspect-ratio: 3 / 4;
		background-color: #dcdcdc;
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.06);
		overflow: hidden;
		position: relative;
	}
	.portrait-frame img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.portrait-placeholder {
		display: none;
		width: 100%;
		height: 100%;
		align-items: center;
		justify-content: center;
		font-size: 0.75rem;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: #888888;
	}

	@media (max-width: 768px) {
		.architect-card {
			grid-template-columns: 1fr;
		}
		.architect-role {
			margin-bottom: 4rem;
		}
		.card-right {
			padding: 2.5rem 1.5rem;
		}
	}
</style>