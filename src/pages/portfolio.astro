---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Experience & Portfolio | NGUYEN HOANG NAM">
	<section class="experience-section">
		<h1 class="section-heading">WORK EXPERIENCE</h1>

		<div class="timeline-wrapper">
			<div class="timeline-track">
				<!-- Mốc 1: 2026 -->
				<a href="/experience/onecons" class="timeline-item top">
					<div class="node"></div>
					<div class="stem"><span class="stem-dot"></span></div>
					<div class="content">
						<h3 class="role">Design Manager <span class="arrow">&nearr;</span></h3>
						<p class="company">Onecons</p>
						<span class="year">2026</span>
					</div>
				</a>

				<!-- Mốc 2: 2025 -->
				<a href="/experience/slcc-novaland" class="timeline-item bottom">
					<div class="node"></div>
					<div class="stem"><span class="stem-dot"></span></div>
					<div class="content">
						<h3 class="role">Freelance Architect <span class="arrow">&nearr;</span></h3>
						<p class="company">SLCC Corp, Novaland Group</p>
						<span class="year">2025</span>
					</div>
				</a>

				<!-- Mốc 3: 2024 -->
				<a href="/experience/prime-homes" class="timeline-item top">
					<div class="node"></div>
					<div class="stem"><span class="stem-dot"></span></div>
					<div class="content">
						<h3 class="role">Team Leader <span class="arrow">&nearr;</span></h3>
						<p class="company">Prime Homes</p>
						<span class="year">2024</span>
					</div>
				</a>

				<!-- Mốc 4: 2020 - 2024 -->
				<a href="/experience/roomplus-global" class="timeline-item bottom">
					<div class="node"></div>
					<div class="stem"><span class="stem-dot"></span></div>
					<div class="content">
						<h3 class="role">Project Architect <span class="arrow">&nearr;</span></h3>
						<p class="company">Roomplus Global</p>
						<span class="year">2020 - 2024</span>
					</div>
				</a>

				<!-- Mốc 5: 2018 - 2020 -->
				<a href="/experience/mitek-vietnam" class="timeline-item top">
					<div class="node"></div>
					<div class="stem"><span class="stem-dot"></span></div>
					<div class="content">
						<h3 class="role">Team Leader <span class="arrow">&nearr;</span></h3>
						<p class="company">Mitek Vietnam</p>
						<span class="year">2018 - 2020</span>
					</div>
				</a>

				<!-- Mốc 6: 2014 - 2018 -->
				<a href="/experience/ge-global" class="timeline-item bottom">
					<div class="node"></div>
					<div class="stem"><span class="stem-dot"></span></div>
					<div class="content">
						<h3 class="role">Architect <span class="arrow">&nearr;</span></h3>
						<p class="company">GE Global, Freelancer</p>
						<span class="year">2014 - 2018</span>
					</div>
				</a>
			</div>
		</div>
	</section>

</Layout>

<style>
	/* ================= TIMELINE WORK EXPERIENCE ================= */
	.experience-section {
		margin-bottom: 6rem;
		padding-bottom: 4rem;
		border-bottom: 1px solid var(--border);
	}
	.section-heading {
		text-align: center;
		font-size: 1.5rem;
		font-weight: 500;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--accent); /* Màu đỏ cam thương hiệu #ef4b2b */
		margin-bottom: 3rem;
	}

	.timeline-wrapper {
		width: 100%;
		overflow-x: auto;
		padding: 1rem 0;
	}

	/* Đường trục ngang chính nằm giữa */
	.timeline-track {
		position: relative;
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		min-width: 860px; /* Đảm bảo tỷ lệ thoáng trên màn hình rộng */
		height: 320px;
		align-items: center;
	}
	.timeline-track::before {
		content: '';
		position: absolute;
		top: 50%;
		left: 0;
		right: 0;
		height: 1px;
		background-color: #cccccc;
		transform: translateY(-50%);
		z-index: 1;
	}
	/* Đường chấm bi chạy đè lên trục chính giống bản vẽ */
	.timeline-track::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 0;
		right: 0;
		height: 2px;
		background-image: radial-gradient(circle, #666666 1px, transparent 1px);
		background-size: 8px 2px;
		transform: translateY(-50%);
		z-index: 1;
	}

	.timeline-item {
		position: relative;
		height: 100%;
		display: flex;
		justify-content: flex-start;
		padding-left: 12px;
	}

	/* Chấm tròn lớn trên trục ngang */
	.node {
		position: absolute;
		top: 50%;
		left: 12px;
		width: 16px;
		height: 16px;
		border-radius: 50%;
		background-color: var(--accent);
		transform: translate(-50%, -50%);
		z-index: 3;
		transition: transform 0.25s ease;
	}
	.timeline-item:hover .node {
		transform: translate(-50%, -50%) scale(1.25);
	}

	/* Đường gióng thẳng đứng */
	.stem {
		position: absolute;
		left: 12px;
		width: 1.5px;
		height: 105px;
		background-color: var(--accent);
		transform: translateX(-50%);
		z-index: 2;
	}
	/* Chấm tròn nhỏ ở đầu đường gióng */
	.stem-dot {
		position: absolute;
		left: 50%;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background-color: var(--accent);
		transform: translateX(-50%);
	}

	/* Nội dung chữ bên cạnh đường gióng */
	.content {
		position: absolute;
		left: 26px;
		width: 175px;
		display: flex;
		flex-direction: column;
		gap: 0.28rem;
	}
	.role {
		font-size: 0.92rem;
		font-weight: 600;
		color: var(--text-main);
		line-height: 1.3;
		transition: color 0.25s ease;
	}
	.company {
		font-size: 0.85rem;
		font-weight: 500;
		color: oklab(41.316% -0.04837 -0.07828); /* Màu xanh ngọc mặc định cho tên công ty */
		line-height: 1.35;
	}
	.year {
		font-size: 0.82rem;
		color: var(--text-muted);
		letter-spacing: 0.04em;
		margin-top: 0.1rem;
	}

	/* Vị trí nhánh TRÊN (2026, 2024, 2018-2020) */
	.timeline-item.top .stem {
		bottom: 50%;
	}
	.timeline-item.top .stem-dot {
		top: 0;
	}
	.timeline-item.top .content {
		top: calc(50% - 108px);
	}

	/* Vị trí nhánh DƯỚI (2025, 2020-2024, 2014-2018) */
	.timeline-item.bottom .stem {
		top: 50%;
	}
	.timeline-item.bottom .stem-dot {
		bottom: 0;
	}
	.timeline-item.bottom .content {
		bottom: calc(50% - 108px);
	}

	/* ================= SELECTED WORKS ================= */
	.works-header {
		margin-bottom: 3rem;
	}
	.works-header h2 {
		font-size: 1.4rem;
		font-weight: 300;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--accent);
		margin-bottom: 0.6rem;
	}
	.works-header p {
		font-size: 0.88rem;
		color: var(--text-muted);
		max-width: 520px;
		line-height: 1.6;
	}
	.projects-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 3rem 2.5rem;
		margin-bottom: 3rem;
	}
	.project-card {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		color: inherit;
	}
	.image-frame {
		width: 100%;
		aspect-ratio: 4 / 3;
		background-color: #f0f0f0;
		border: 1px solid var(--border);
		margin-bottom: 1.1rem;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: border-color 0.25s ease;
	}
	.project-card:hover .image-frame {
		border-color: var(--accent);
	}
	.image-placeholder {
		font-size: 0.75rem;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: #999999;
	}
	.project-meta {
		display: flex;
		justify-content: space-between;
		margin-bottom: 0.4rem;
	}
	.project-num {
		font-size: 0.78rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		color: var(--accent);
	}
	.project-year {
		font-size: 0.75rem;
		color: var(--text-muted);
	}
	.project-title {
		font-size: 1.05rem;
		font-weight: 400;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		margin-bottom: 0.4rem;
	}
	.project-desc {
		font-size: 0.85rem;
		color: var(--text-muted);
		line-height: 1.5;
	}

	/* ================= RESPONSIVE MOBILE (TRỤC GIỮA SO LE TRÁI - PHẢI CHUẨN XÁC) ================= */
	@media (max-width: 768px) {
		.timeline-wrapper {
			overflow-x: visible;
			padding: 0.5rem 0;
		}
		.timeline-track {
			display: flex;
			flex-direction: column;
			min-width: 100%;
			height: auto;
			gap: 2.8rem;
			padding: 0;
		}
		/* Đường trục dọc chạy chính giữa 50% */
		.timeline-track::before {
			top: 0;
			bottom: 0;
			left: 50%;
			right: auto;
			width: 1px;
			height: 100%;
			transform: translateX(-50%);
		}
		.timeline-track::after {
			display: none;
		}
		.timeline-item {
			display: block;
			width: 100%;
			height: auto;
			padding: 0;
		}

		/* 1. Chấm tròn lớn nằm đúng tâm trục giữa (tâm nằm ở y = 12px) */
		.node {
			top: 6px;
			left: 50%;
			width: 12px;
			height: 12px;
			transform: translateX(-50%);
		}
		.timeline-item:hover .node {
			transform: translateX(-50%) scale(1.2);
		}

		/* 2. Thanh chỉ ngang: ép cả top và bottom cho cả .top lẫn .bottom về đúng tâm y = 11.5px */
		.timeline-item.top .stem,
		.timeline-item.bottom .stem {
			display: block;
			top: 11.5px;
			bottom: auto;
			width: 18px;
			height: 1px;
			transform: none;
		}

		/* 3. Chấm tròn nhỏ ở đầu thanh chỉ ngang */
		.timeline-item.top .stem-dot,
		.timeline-item.bottom .stem-dot {
			top: 50%;
			bottom: auto;
			width: 4px;
			height: 4px;
			transform: translateY(-50%);
		}

		/* Reset vị trí khối chữ */
		.timeline-item.top .content,
		.timeline-item.bottom .content {
			position: static;
			top: auto;
			bottom: auto;
			left: auto;
			width: calc(50% - 26px);
		}

		/* Nhánh .top nằm bên PHẢI trục giữa */
		.timeline-item.top .stem {
			left: 50%;
		}
		.timeline-item.top .stem-dot {
			left: auto;
			right: 0;
		}
		.timeline-item.top .content {
			margin-left: calc(50% + 26px);
			text-align: left;
		}

		/* Nhánh .bottom nằm bên TRÁI trục giữa */
		.timeline-item.bottom .stem {
			left: calc(50% - 18px);
		}
		.timeline-item.bottom .stem-dot {
			left: 0;
		}
		.timeline-item.bottom .content {
			margin-right: calc(50% + 26px);
			text-align: right;
		}
	}

	/* Biến mốc Timeline thành liên kết mượt mà */
	a.timeline-item {
		text-decoration: none;
		color: inherit;
		cursor: pointer;
	}
	.role .arrow {
		font-size: 0.78rem;
		color: var(--accent);
		opacity: 0.5;
		display: inline-block;
		transition: transform 0.25s ease, opacity 0.25s ease;
	}
	a.timeline-item:hover .role {
		color: var(--accent);
	}
	a.timeline-item:hover .role .arrow {
		opacity: 1;
		transform: translate(2px, -2px);
	}
</style>