---
import Layout from '../layouts/Layout.astro';
---

<Layout title="NAMK" hideChrome={true}>
	<main class="hero">
		<h1>N A M K</h1>
		<p>Welcome to Architect NGUYEN HOANG NAM's portfolio</p>
		<a href="/portfolio" class="btn-outline">Explore Works &rarr;</a>
	</main>
</Layout>

<style>
	.hero {
		height: 100vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		padding: 1.5rem;
	}
	h1 {
		font-size: 2.3rem;
		font-weight: 400;
		letter-spacing: 0.25em;
		text-transform: uppercase;
		color: var(--accent);
		margin-bottom: 0.6rem;
	}
	p {
		font-size: 0.9rem;
		color: var(--text-muted);
		letter-spacing: 0.08em;
		margin-bottom: 2.2rem;
	}
</style>